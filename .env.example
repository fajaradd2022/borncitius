# ── apps/api ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://borncitius:borncitius_dev@localhost:5433/borncitius?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6380
PORT=4000

# Ganti dengan nilai acak panjang di produksi: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

STORAGE_ROOT=/var/born-citius/storage
CORS_ORIGIN=http://localhost:3002

# Mirror Google Drive (rclone). Remote & credential dibaca dari
# ~/.config/rclone/rclone.conf — file itu TIDAK diubah oleh aplikasi.
GDRIVE_ENABLED=true
GDRIVE_REMOTE=gdrive
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_BASE_PATH=BORN CITIUS
RCLONE_BIN=rclone

# ── services/claude-bridge ──────────────────────────────────────────────
BRIDGE_PORT=8787
BRIDGE_HOST=0.0.0.0
BRIDGE_TOKEN=
BRIDGE_ALLOWED_DIR=/tmp/born-citius-ai
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-opus-5

# ── apps/web-admin (.env.local) ─────────────────────────────────────────
AI_ENABLED=true
AI_N8N_WEBHOOK_URL=http://localhost:5678/webhook/born-citius-layout-ai
AI_UPLOAD_DIR=/tmp/born-citius-ai
AI_TIMEOUT_MS=300000
