# Salin menjadi .env.production.local (untuk build APK) atau .env.local (untuk `pnpm dev`).
#
# URL API yang dipanggil aplikasi, dibakar saat build:
# - APK      : URL absolut server kantor, mis. https://fse.fajarsodiq.com/api
# - Dev lokal: http://localhost:4000/api  (CORS_ORIGIN API harus memuat http://localhost:3003)
# - Web/Docker tidak perlu file ini (default "/api", diteruskan nginx).
#
# API juga harus mengizinkan origin APK di CORS_ORIGIN: https://localhost
NEXT_PUBLIC_API_URL=https://fse.fajarsodiq.com/api
